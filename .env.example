# Copy to .env.local. Defaults match docker-compose.yml (local pgvector).
DATABASE_URL=postgres://gang:gang@localhost:5434/gang

# Optional: without these, every PO/BA/DEV/QA stage uses its deterministic
# template (the default, zero-config behavior). Set both GANG_LLM_PROVIDER
# and GANG_LLM_MODEL plus the matching *_API_KEY below to have that stage
# use a real LLM instead — see the `models` command to check what's active.
# GANG_LLM_PROVIDER=claude   # claude | openai | deepseek
# GANG_LLM_MODEL=            # e.g. claude-sonnet-5, gpt-6-astra, deepseek-v4-pro — check the provider's current model list
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
